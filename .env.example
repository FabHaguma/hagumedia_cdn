# Postgres connection used by the API and the migration/seed scripts
DATABASE_URL=postgres://hagumedia:changeme@localhost:5432/hagumedia

# Used by docker-compose to provision the postgres container
POSTGRES_DB=hagumedia
POSTGRES_USER=hagumedia
POSTGRES_PASSWORD=changeme

# Fastify bind settings
HOST=0.0.0.0
PORT=3000

# Root directory (inside the container / on the VPS) where tenant images are written
STORAGE_ROOT=./storage

# Hard cap on upload size in bytes, mirrors the limit enforced by Caddy
MAX_UPLOAD_BYTES=10485760

# Public domain for the CDN (DNS A record must point at this VPS). Enables
# automatic HTTPS via Caddy. Leave unset to bind plain :80 for local/IP testing.
# DOMAIN=cdn.example.com
